---
// Equipo médico: foto redonda, nombre, especialidad y número de colegiado (en `texto`).
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {s.personas.map((p) => (
          <li class="tarjeta flex items-center gap-5 p-5">
            <Imagen src={p.foto} alt={`Foto de ${p.nombre}`} ancho={600} alto={720} class="h-20 w-20 shrink-0 rounded-full object-cover ring-4 ring-primario/10" />
            <div class="min-w-0">
              <p class="font-semibold">{p.nombre}</p>
              {p.cargo && <p class="text-sm text-primario">{p.cargo}</p>}
              {p.texto && <p class="mt-1 text-xs opacity-60">{p.texto}</p>}
            </div>
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
