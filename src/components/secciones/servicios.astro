---
// Tratamientos: rejilla de tarjetas con icono en cuadrado tintado.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} class="tinte">
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {s.items.map((it) => (
          <li class="tarjeta p-6">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-primario/10 text-primario">
              <Icono nombre={it.icono} />
            </span>
            <h3 class="mt-5 text-lg">{it.titulo}</h3>
            {it.texto && <p class="mt-2 text-[.95rem] opacity-70">{it.texto}</p>}
          </li>
        ))}
      </ul>
    </Seccion>
  )
}
