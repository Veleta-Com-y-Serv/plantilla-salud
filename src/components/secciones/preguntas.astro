---
// Preguntas frecuentes: acordeón nativo (<details>), sin JavaScript.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} contenedor="max-w-3xl">
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <div class="grid gap-3">
        {s.preguntas.map((p, i) => (
          <details class="faq tarjeta px-5 py-1" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 py-4 font-semibold">
              {p.pregunta}
              <span class="faq-signo grid h-7 w-7 shrink-0 place-items-center rounded-full bg-primario/10 text-primario transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="pb-5 opacity-75">{p.respuesta}</p>
          </details>
        ))}
      </div>
    </Seccion>
  )
}
